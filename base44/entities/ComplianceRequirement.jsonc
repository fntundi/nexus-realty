{
  "name": "ComplianceRequirement",
  "type": "object",
  "properties": {
    "market_id": {
      "type": "string",
      "description": "Reference to Market entity"
    },
    "stage": {
      "type": "string",
      "enum": [
        "pre_qual",
        "showing",
        "offer",
        "under_contract",
        "closing"
      ],
      "description": "Transaction stage this requirement applies to"
    },
    "requirement_name": {
      "type": "string",
      "description": "Name of the requirement (e.g., Buyer Agency Agreement)"
    },
    "description": {
      "type": "string",
      "description": "Detailed explanation of the requirement"
    },
    "required_document_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Document types that must be uploaded"
    },
    "applicable_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "agent",
          "buyer",
          "lender",
          "builder"
        ]
      },
      "description": "Which roles this requirement applies to"
    },
    "is_mandatory": {
      "type": "boolean",
      "default": true,
      "description": "Whether this blocks stage progression"
    },
    "educational_content": {
      "type": "string",
      "description": "Educational content or warnings to display"
    },
    "order": {
      "type": "number",
      "description": "Display order within the stage"
    }
  },
  "required": [
    "market_id",
    "stage",
    "requirement_name"
  ]
}