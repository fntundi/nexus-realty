{
  "name": "AppConfig",
  "type": "object",
  "properties": {
    "config_key": {
      "type": "string",
      "description": "Unique configuration key"
    },
    "config_value": {
      "type": "object",
      "description": "Configuration value as JSON object"
    },
    "description": {
      "type": "string",
      "description": "Description of this configuration"
    }
  },
  "required": [
    "config_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}