{
  "name": "Notification",
  "type": "object",
  "properties": {
    "recipient_email": {
      "type": "string",
      "description": "Email of notification recipient"
    },
    "notification_type": {
      "type": "string",
      "enum": [
        "lead_assigned",
        "deal_update",
        "document_request",
        "closing_reminder",
        "new_offer",
        "system"
      ],
      "description": "Type of notification"
    },
    "title": {
      "type": "string",
      "description": "Notification title"
    },
    "message": {
      "type": "string",
      "description": "Notification message content"
    },
    "related_entity_type": {
      "type": "string",
      "enum": [
        "lead",
        "transaction",
        "document",
        "message"
      ],
      "description": "Entity type this notification relates to"
    },
    "related_entity_id": {
      "type": "string",
      "description": "ID of the related entity"
    },
    "action_url": {
      "type": "string",
      "description": "URL to navigate to for this notification"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether notification has been read"
    },
    "read_date": {
      "type": "string",
      "format": "date-time",
      "description": "When notification was read"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "description": "Notification priority level"
    },
    "metadata": {
      "type": "object",
      "description": "Additional context (property address, buyer name, deal value, etc.)"
    }
  },
  "required": [
    "recipient_email",
    "notification_type",
    "title",
    "message"
  ]
}