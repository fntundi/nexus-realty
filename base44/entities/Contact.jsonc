{
  "name": "Contact",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "Contact first name"
    },
    "last_name": {
      "type": "string",
      "description": "Contact last name"
    },
    "email": {
      "type": "string",
      "description": "Contact email address"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "company": {
      "type": "string",
      "description": "Company name"
    },
    "contact_type": {
      "type": "string",
      "enum": [
        "buyer",
        "seller",
        "lender",
        "other"
      ],
      "description": "Type of contact"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "prospect"
      ],
      "default": "prospect",
      "description": "Contact status"
    },
    "market_id": {
      "type": "string",
      "description": "Reference to Market entity"
    },
    "assigned_agent_email": {
      "type": "string",
      "description": "Email of assigned agent"
    },
    "related_lead_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Related Lead entity IDs"
    },
    "related_transaction_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Related Transaction entity IDs"
    },
    "address": {
      "type": "string",
      "description": "Contact address"
    },
    "city": {
      "type": "string",
      "description": "City"
    },
    "state": {
      "type": "string",
      "description": "State"
    },
    "zip_code": {
      "type": "string",
      "description": "Zip code"
    },
    "notes": {
      "type": "string",
      "description": "General notes about the contact"
    },
    "last_interaction_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date of last interaction"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Tags for organization"
    },
    "lead_score": {
      "type": "number",
      "default": 0,
      "description": "Automated lead score (0-100)"
    },
    "score_breakdown": {
      "type": "object",
      "description": "Score breakdown by category",
      "properties": {
        "interaction_score": {
          "type": "number",
          "default": 0
        },
        "demographic_score": {
          "type": "number",
          "default": 0
        },
        "engagement_score": {
          "type": "number",
          "default": 0
        }
      }
    },
    "score_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "score": {
            "type": "number"
          },
          "calculated_date": {
            "type": "string",
            "format": "date-time"
          },
          "breakdown": {
            "type": "object"
          }
        }
      },
      "default": [],
      "description": "Historical lead scores"
    },
    "last_score_update": {
      "type": "string",
      "format": "date-time",
      "description": "When lead score was last calculated"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "email"
  ]
}