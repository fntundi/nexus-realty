{
  "name": "MarketDataConfig",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "zillow",
        "redfin",
        "realtor",
        "custom"
      ],
      "description": "Market data provider"
    },
    "is_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether market data integration is active"
    },
    "api_key": {
      "type": "string",
      "description": "API key for the provider (encrypted)"
    },
    "api_url": {
      "type": "string",
      "description": "Base API URL for the provider"
    },
    "rate_limit_per_day": {
      "type": "number",
      "default": 1000,
      "description": "Daily API call limit"
    },
    "calls_today": {
      "type": "number",
      "default": 0,
      "description": "API calls made today"
    },
    "last_reset_date": {
      "type": "string",
      "format": "date",
      "description": "Last rate limit reset date"
    },
    "supported_features": {
      "type": "object",
      "properties": {
        "property_estimates": {
          "type": "boolean",
          "default": false
        },
        "market_trends": {
          "type": "boolean",
          "default": false
        },
        "neighborhood_stats": {
          "type": "boolean",
          "default": false
        },
        "comparable_sales": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "cache_duration_hours": {
      "type": "number",
      "default": 24,
      "description": "How long to cache market data"
    },
    "markets_enabled": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Market IDs where this integration is active"
    }
  },
  "required": [
    "provider"
  ]
}